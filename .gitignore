# ==============================================================================
# PS105 – Cyber Risk Quantification & Security Investment Optimization
# Root .gitignore Specification
# ==============================================================================

# Python bytecode & caching
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg-info/
dist/
build/
*.egg

# Testing & coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.cover
.hypothesis/

# SQLite databases (local runtime databases)
*.db
*.db-journal
*.sqlite
*.sqlite3

# Environment files — never commit credentials
.env
.env.*
!.env.example
*.local

# Virtual environments
venv/
.venv/
ENV/
env/

# Node.js / Frontend dependencies & build outputs
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Generated PDF reports & temporary artifacts
*.pdf
backend/*.pdf

# IDE & Editor configuration
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
.DS_Store
Thumbs.db
desktop.ini

# Antigravity agent & local assistant artifacts
.agents/
skills-lock.json
.gemini/
scratch/

# Secrets, private certificates & keys
*.pem
*.key
*.crt
*.cert
