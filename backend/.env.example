# ==============================================================================
# PS105 Backend Environment Configuration Template
# Copy this file to backend/.env or project root .env and configure values.
# ==============================================================================

# Application Environment ('development' | 'staging' | 'production')
ENV=development

# Database Connection URL
# SQLite default: sqlite:///./ps105.db
# PostgreSQL example: postgresql://user:password@localhost:5432/ps105_db
DATABASE_URL=sqlite:///./ps105.db

# JWT Cryptographic Signing Key
# In production, generate a strong random 256-bit key (e.g. `openssl rand -hex 32`)
SECRET_KEY=ps105_secret_key_change_in_production_environment_987654321

# JWT Cryptographic Algorithm (default: HS256)
ALGORITHM=HS256

# JWT Token Expiration in Minutes (default: 10080 minutes = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Demonstration Seed User Password
# Required in production; defaults to 'password123' in development if omitted
DEMO_USER_PASSWORD=password123

# Bcrypt Hashing Rounds (default: 12 in production, 4 in test environments)
BCRYPT_ROUNDS=12
